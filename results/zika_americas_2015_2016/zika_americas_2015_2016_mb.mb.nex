#NEXUS
begin mrbayes;
    set autoclose=yes nowarn=yes;
    set seed=42 swapseed=42;
    execute datasets/zika_americas_2015_2016/analysis.nex;
    lset nst=6 rates=invgamma;
    prset statefreqpr=dirichlet(1,1,1,1) revmatpr=dirichlet(1,1,1,1,1,1)
          shapepr=exponential(1.0) pinvarpr=uniform(0,1)
          brlenspr=unconstrained:gammadir(1,1000,1,1);
    mcmcp ngen=800000 nruns=2 nchains=4 samplefreq=80
          printfreq=40000 diagnfreq=40000
          filename=results/zika_americas_2015_2016/zika_americas_2015_2016_mb;
    mcmc;
    sumt relburnin=yes burninfrac=0.25 conformat=simple contype=allcompat;
    sump relburnin=yes burninfrac=0.25;
end;
